# Copy to .env and set deployment-specific values. Never commit real values.
ENVIRONMENT=development
SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=10080
# Local referral URLs must point back to the local API instance.
REFERRAL_TRACKING_BASE_URL=http://127.0.0.1:8001

POSTGRES_SERVER=127.0.0.1
POSTGRES_USER=replace-me
POSTGRES_PASSWORD=replace-me
POSTGRES_DB=replace-me
POSTGRES_PORT=5432
REDIS_URL=redis://127.0.0.1:6379/0

# Email recovery requires a verified sender and an app password/provider secret.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=
EMAILS_FROM_NAME=AM5 ROYAL

# MyText SMS provider. Set a DLT-approved password-reset template ID and exact
# approved template text containing {otp}; do not paste an unapproved template.
SMS_USER_ID=
SMS_PASSWORD=
SMS_SENDER_ID=
SMS_PEID=
SMS_OTP_TPID=
SMS_PASSWORD_RESET_TPID=
SMS_PASSWORD_RESET_TEMPLATE=

# Optional voice providers; credentials have no source-code defaults.
AIRTEL_IQ_APP_ID=
AIRTEL_IQ_API_KEY=
SMARTFLO_API_TOKEN=
